---
import WikiIcon from './WikiIcon.astro';
import { href, labels, shortTitle, type WikiPage } from '../utils/wiki';

interface Props {
  current: WikiPage;
  parent?: WikiPage;
  siblings: WikiPage[];
}

const { current, parent, siblings } = Astro.props;
const { lang } = current;
const text = labels[lang];
const local = parent?.slug ? parent : undefined;
const parentHref = local ? href(local.slug, lang) : href('', lang) + '#explorar';
---

<aside class="section-rail">
  <details class="section-nav" open data-section-nav>
    <summary><WikiIcon name="folder" size={17} /><span>{lang === 'en' ? 'Section' : 'Seção'}</span><WikiIcon name="chevron-down" size={15} /></summary>
    <nav aria-label={lang === 'en' ? 'Section navigation' : 'Navegação da seção'}>
      <a class="section-parent" href={parentHref}>
        <WikiIcon name="arrow-left" size={15} /><span>{local ? shortTitle(local) : text.allTopics}</span>
      </a>
      {siblings.length > 0 && (
        <ul>
          {siblings.map((item) => (
            <li>
              <a href={href(item.slug, lang)} aria-current={item.slug === current.slug ? 'page' : undefined}>
                <WikiIcon name={item.section ? 'folder' : 'file'} size={14} /><span>{shortTitle(item)}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </nav>
  </details>
</aside>

<style>
  .section-rail { min-width: 0; }
  summary, .section-parent, li > a {
    display: flex;
    align-items: center;
    gap: .5rem;
    min-block-size: 36px;
    padding: .38rem .55rem;
    line-height: 1.37;
    text-decoration: none;
    color: var(--muted);
    font-size: var(--text-supporting);
    border-radius: var(--radius-control);
  }
  :is(summary, a):hover { color: var(--accent); background: var(--panel); }
  li > a[aria-current=page] { color: var(--accent); background: var(--area); font-weight: 600; }
  :is(summary, a) > :global(svg) { flex: none; }
  :is(summary, a) > span { min-inline-size: 0; overflow-wrap: anywhere; }
  summary {
    border: 1px solid var(--line);
    min-block-size: 44px;
    padding-inline: .75rem;
    border-radius: 999px;
    background: var(--panel);
    color: var(--muted-on-panel, var(--muted));
  }
  summary :global(svg:last-child) { margin-inline-start: auto; }
  details[open] summary :global(svg:last-child) { rotate: 180deg; }
  nav { margin-block-start: .5rem; }
  ul { padding: 0; margin: 0; list-style: none; }
  .section-parent { margin-block-end: .35rem; color: var(--ink); font-weight: 560; }

  @media (min-width: 65rem) {
    .section-rail {
      grid-column: 1;
      grid-row: 1 / span 7;
      position: sticky;
      top: 7rem;
      max-block-size: calc(100dvh - 8rem);
      overflow-y: auto;
      padding: .25rem .35rem;
      scrollbar-gutter: stable;
    }
    summary { display: none; }
    nav { margin-block-start: 0; }
  }
  @media (max-width: 64.999rem) {
    nav {
      position: absolute;
      z-index: 4;
      inset: calc(100% + 6px) auto auto 0;
      width: min(22rem, 100%);
      max-height: min(55dvh, 420px);
      overflow: auto;
      overscroll-behavior: contain;
      margin: 0;
      padding: 8px;
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
      background: var(--panel);
      box-shadow: 0 10px 35px #0003;
    }
    :is(.section-parent, li > a) { min-block-size: 44px; }
  }
  @media print { .section-rail { display: none; } }
</style>
