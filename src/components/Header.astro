---
import WikiWordmark from './WikiWordmark.astro';
import NavIcon from './NavIcon.astro';
import GlowButton from './GlowButton.astro';
import WikiIcon from './WikiIcon.astro';
import { contactUrl, navigationTopics } from '../data/navigation';
import { href, labels, shortTitle, topicIcons, type Language, type WikiPage } from '../utils/wiki';

interface Props {
  lang: Language;
  alternate: string;
  slug: string;
  topics: WikiPage[];
  reading: boolean;
}
const { lang, alternate, slug, topics, reading } = Astro.props;
const english = lang === 'en';
const text = labels[lang];
const contact = english ? 'Contact' : 'Contato';
const otherLanguage = english ? 'Português' : 'English';
const currentLanguage = english ? 'English' : 'Português';
const navigation = navigationTopics[lang].flatMap((topic) => {
  const page = topics.find((item) => item.slug === topic);
  if (!page) return [];
  return [{
    path: href(topic, lang),
    title: shortTitle(page),
    icon: topicIcons[topic],
    current: slug === topic ? 'page' as const : slug.startsWith(topic + '/') ? 'location' as const : undefined,
  }];
});
---

<header class="site-header">
  <nav id="site-navigation" class="site-nav" aria-label={english ? 'Main navigation' : 'Navegação principal'} data-nav-track>
    <span class="nav-pill" data-nav-pill aria-hidden="true"></span>
    {reading && <span class="nav-progress" aria-hidden="true"><span class="nav-progress-fill"></span></span>}
    <button class="nav-launch" type="button" data-nav-launch aria-expanded="false" aria-controls="site-navigation"
      aria-label={english ? 'Open navigation menu' : 'Abrir menu de navegação'}>
      <WikiWordmark compact />
      <WikiIcon name="menu" />
    </button>
    <a class="nav-brand" href={href('', lang)} data-nav-item data-mobile-label="Garden Wiki" aria-label="Garden Wiki"
      aria-current={!slug ? 'page' : undefined}>
      <WikiWordmark />
    </a>
    {navigation.map(({ path, title, current }) => (
      <a class="nav-link nav-topic" data-nav-item href={path} aria-current={current}>{title}</a>
    ))}
    <a class="nav-link nav-contact" href={contactUrl} data-nav-item aria-label={contact} title={contact}>
      <span class="nav-label">{contact}</span><WikiIcon name="arrow-up-right" size={14} />
    </a>
    <details class="nav-disclosure nav-explore" data-nav-disclosure>
      <summary class="nav-link" data-nav-item data-mobile-label={text.subjects} aria-label={text.subjects}>
        <WikiIcon name="folder" />
      </summary>
      <div class="nav-panel">
        {navigation.map(({ path, title, icon, current }) => (
          <a href={path} aria-current={current}><WikiIcon name={icon} size={16} />{title}</a>
        ))}
        <a href={contactUrl}>{contact}<WikiIcon name="arrow-up-right" size={14} /></a>
      </div>
    </details>
    <button type="button" class="nav-link nav-search" data-nav-item data-mobile-label={text.search}
      data-search-open aria-label={text.search} aria-haspopup="dialog" title={text.search} hidden>
      <WikiIcon name="search" />
    </button>
    <details class="nav-disclosure nav-theme" data-nav-disclosure>
      <summary class="nav-link" data-nav-item data-mobile-label={text.theme} aria-label={text.theme} title={text.theme}>
        <WikiIcon name="theme" />
      </summary>
      <div class="nav-panel theme-panel" role="group" aria-label={text.theme}>
        {Object.entries(text.themeOptions).map(([value, label]) => (
          <GlowButton variant="ghost" size="sm" data-theme={value}
            aria-pressed={value === 'sistema' ? 'true' : 'false'}>{label}</GlowButton>
        ))}
      </div>
    </details>
    <details class="nav-disclosure nav-locale" data-nav-disclosure>
      <summary class="nav-link" data-nav-item data-mobile-label={english ? 'Language' : 'Idioma'}
        aria-label={english ? 'EN, select language' : 'PT, selecionar idioma'}>
        <NavIcon name="language" />
        <span class="nav-label">{english ? 'EN' : 'PT'}</span>
      </summary>
      <div class="nav-panel locale-panel">
        {english && <a href={alternate} hreflang="pt-BR" lang="pt-BR">Português <small aria-hidden="true">PT</small></a>}
        <span aria-current="true">{currentLanguage} <small aria-hidden="true">{english ? 'EN' : 'PT'}</small></span>
        {!english && <a href={alternate} hreflang="en" lang="en">{otherLanguage} <small aria-hidden="true">EN</small></a>}
      </div>
    </details>
    <button class="nav-close" type="button" data-nav-close aria-controls="site-navigation"
      aria-label={english ? 'Close navigation menu' : 'Recolher menu de navegação'}>
      <WikiIcon name="close" />
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 18px;
    z-index: 25;
    overflow-anchor: none;
    display: flex;
    justify-content: center;
    margin-top: 22px;
    padding-inline: 12px;
    pointer-events: none;
  }

  .site-nav {
    position: relative;
    display: flex;
    align-items: center;
    padding: 4px;
    gap: 3px;
    max-width: 100%;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--panel) 94%, transparent);
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 28px #0002;
    pointer-events: auto;
  }

  .nav-progress {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    overflow: hidden;
    color: color-mix(in srgb, var(--accent) 65%, var(--line));
    pointer-events: none;
  }

  .nav-progress-fill {
    --shimmer-delay: 16s;
    position: absolute;
    inset: auto 0 1px;
    block-size: 2px;
    background: currentColor;
    transform-origin: left center;
    transform: scaleX(var(--page-progress, 0));
  }

  @media (forced-colors: active) {
    .nav-progress { color: Highlight; forced-color-adjust: none; }
    .nav-progress-fill::after { display: none; }
  }

  .nav-brand, .nav-link {
    align-items: center;
    justify-content: center;
    display: flex;
    gap: 6px;
    min-height: 44px;
    padding: 0 17px;
    border-radius: 999px;
    touch-action: manipulation;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-brand { padding: 0 10px; }
  .nav-topic { padding-inline: 10px; }
  .nav-launch, .nav-close { display: none; border: 0; background: transparent; }
  .nav-link { color: var(--muted-on-panel, var(--muted)); font-size: 14px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .nav-link:is(:hover, [aria-current], [data-revealed]), .nav-active, .nav-disclosure[open] summary {
    color: var(--accent);
  }
  .site-nav:not([data-nav-ready]) :is(.nav-link:hover, .nav-link[aria-current], .nav-active, .nav-disclosure[open] summary) {
    background: var(--area);
  }

  .nav-disclosure { z-index: 2; }
  .nav-explore { display: none; }
  .nav-locale { padding-left: 7px; }
  .nav-locale > summary::before {
    content: '';
    position: absolute;
    inset: 11px auto 11px -5px;
    width: 1px;
    background: var(--line);
  }

  .nav-panel {
    position: absolute;
    inset: calc(100% + 10px) 0 auto auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    width: min(290px, calc(100vw - 24px));
    max-height: min(65dvh, 320px);
    overflow: auto;
    padding: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--panel);
    box-shadow: 0 10px 35px #0003;
  }

  .nav-panel > * {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
    min-height: 44px;
    border-radius: var(--radius-control);
    font-size: var(--text-supporting);
    text-decoration: none;
  }

  .nav-panel > :hover, .nav-panel > [aria-current] { background: var(--area); color: var(--accent); }
  .nav-disclosure:not([open]) > .nav-panel { display: none; }
  .theme-panel {
    display: flex;
    flex-wrap: wrap;
    width: max-content;
    max-width: calc(100vw - 24px);
    gap: 4px;
  }
  .nav-panel.theme-panel > :global(button) { border-radius: 999px; }
  .theme-panel > :global([aria-pressed=true]) { color: var(--accent); background: var(--area); }
  button.nav-link { border: 0; background: transparent; }
  .nav-search, .nav-theme > summary, .nav-contact { padding-inline: 12px; }
  .nav-progress-fill { background: var(--accent); }
  .site-nav:not([data-mobile-menu]) .nav-brand[aria-current=page] { background: var(--area); }
  .locale-panel { width: min(195px, calc(100vw - 24px)); grid-template-columns: minmax(0, 1fr); }
  .locale-panel > * { justify-content: space-between; }

  @media (761px <= width <= 960px) and (min-height: 541px) and (pointer: fine) {
    .nav-link { padding-inline: 10px; }
    .nav-contact .nav-label { display: none; }
    .nav-contact { min-width: 40px; }
  }

  @media (max-width: 760px), (pointer: coarse), (max-width: 1024px) and (max-height: 540px) {
    :global(html) { scroll-padding-bottom: calc(75px + env(safe-area-inset-bottom)); }
    :global(.site-stage) { padding-bottom: calc(70px + env(safe-area-inset-bottom)); }

    .site-header {
      position: fixed;
      inset: auto 0 max(12px, env(safe-area-inset-bottom));
      margin: 0;
    }

    .site-nav { gap: 1px; padding: 3px; }
    .nav-brand, .nav-link { width: clamp(38px, 11.6vw, 44px); padding: 0; }
    .nav-label, .site-nav > :is(.nav-topic, .nav-contact) { display: none; }
    .nav-explore { display: block; }
    .nav-brand > :global(.wiki-wordmark) { width: 38px; height: 18px; }
    .nav-panel { inset: auto 0 calc(100% + 10px) auto; }
    .site-nav:not([data-mobile-menu]) [data-mobile-label]:focus-visible::after { display: block; }
    @media (hover: hover) {
      .site-nav:not([data-mobile-menu]) [data-mobile-label]:hover::after { display: block; }
    }
  }

  [data-mobile-label]::after {
    content: attr(data-mobile-label);
    display: none;
    position: absolute;
    inset: auto auto calc(100% + 8px) 50%;
    translate: -50% 0;
    padding: 4px 8px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--area);
    color: var(--ink);
    font-size: var(--text-caption);
    line-height: 1.4;
    pointer-events: none;
  }
  [data-mobile-menu] [data-mobile-label]:is([data-revealed], :focus-visible)::after { display: block; }
  .site-nav .nav-disclosure[open] [data-mobile-label]::after { display: none; }

  @media (hover: hover) {
    [data-mobile-menu] [data-mobile-label]:hover::after { display: block; }
    [data-mobile-menu]:has([data-mobile-label]:hover) [data-revealed]:not(:hover, :focus-visible)::after { display: none; }
  }

  .site-header:has([data-mobile-menu]) {
    justify-content: flex-end;
    padding-inline: max(8px, env(safe-area-inset-left)) max(8px, env(safe-area-inset-right));
  }
  .site-nav[data-mobile-menu] {
    --dock-size: min(100%, 306px);
    gap: 1px;
    padding: 3px;
    width: 92px;
    margin-inline-end: 0;
    transition: width 260ms ease, margin-inline-end 260ms ease;
  }
  .site-nav[data-mobile-menu] :is(.nav-brand, .nav-link) { padding: 0; }
  [data-mobile-menu] .nav-panel { inset: auto 0 calc(100% + 10px) auto; }
  .site-nav[data-mobile-menu="open"] {
    width: var(--dock-size);
    margin-inline-end: calc((100% - var(--dock-size)) / 2);
  }
  [data-mobile-menu="closed"] > :not(.nav-launch, .nav-progress) { display: none; }
  [data-mobile-menu="closed"] > .nav-launch, [data-mobile-menu="open"] > .nav-close {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0;
    border-radius: 999px;
    touch-action: manipulation;
  }
  .nav-launch { flex: 1; gap: 8px; color: var(--ink); }
  .nav-launch :global(svg) { display: block; }
  [data-mobile-menu="open"] > :is(.nav-brand, .nav-link, .nav-disclosure, .nav-close) {
    width: auto;
    min-width: 0;
    flex: 1 1 0;
  }
  [data-mobile-menu="open"] .nav-disclosure > summary { width: 100%; }
  [data-mobile-menu="open"] > :is(.nav-link, .nav-disclosure, .nav-close) {
    animation: dock-items-in 250ms ease both;
  }
  .nav-close { color: var(--muted-on-panel, var(--muted)); }
  @keyframes dock-items-in { 0%, 40% { opacity: 0; } 100% { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .site-nav[data-mobile-menu] { transition: none; }
    .site-nav > .nav-pill { transition: none; }
    [data-mobile-menu="open"] > :is(.nav-link, .nav-disclosure, .nav-close) { animation: none; }
  }

  @media print { .site-header { display: none; } }
</style>
