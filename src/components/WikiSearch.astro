---
import WikiIcon from './WikiIcon.astro';
import { href, labels, type Language } from '../utils/wiki';

interface Props { lang: Language }
const { lang } = Astro.props;
const text = labels[lang];
---

<dialog class="search-dialog" aria-labelledby="search-label" data-search
        data-index={href('', lang) + 'search.json' + (import.meta.env.DEV ? '/' : '')} data-loading={text.loading}
        data-empty={text.empty} data-error={text.searchError}>
  <form method="dialog" class="search-bar">
    <WikiIcon name="search" size={22} />
    <div class="search-field">
      <label class="sr-only" id="search-label" for="wiki-search-input">{text.search}</label>
      <input id="wiki-search-input" type="search" placeholder={text.placeholder} autocomplete="off" autofocus />
    </div>
    <button type="submit" class="icon-button" aria-label={text.close}>
      <WikiIcon name="close" />
    </button>
  </form>
  <div class="search-results" data-search-results></div>
  <p class="search-status" data-search-status role="status" aria-live="polite"></p>
</dialog>

<script>
  import { normalizeSearchText } from '../utils/search-text';

  interface Result {
    title: string;
    url: string;
    group: string;
    summary: string;
    body: string;
  }

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-search-open]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-search]');
  const input = dialog?.querySelector<HTMLInputElement>('input');
  const results = dialog?.querySelector<HTMLElement>('[data-search-results]');
  const status = dialog?.querySelector<HTMLElement>('[data-search-status]');
  const url = dialog?.dataset.index;

  if (buttons.length && dialog && input && results && status && url) {
    for (const button of buttons) button.hidden = false;
    const modifier = document.querySelector('[data-modifier]');
    if (modifier && /Mac|iPhone|iPad/.test(navigator.platform)) modifier.textContent = '⌘';

    let index: Result[] | undefined;
    let fetching = false;

    function update() {
      if (!index || !input || !results || !status || !dialog) return;
      const terms = normalizeSearchText(input.value).split(/\s+/).filter(Boolean);
      const matches = index.flatMap((entry) => {
        const title = normalizeSearchText(entry.title);
        const group = normalizeSearchText(entry.group);
        const body = normalizeSearchText(entry.body);
        let score = 0;
        for (const term of terms) {
          if (title.includes(term)) score += title.startsWith(term) ? 6 : 4;
          else if (group.includes(term)) score += 2;
          else if (body.includes(term)) score += 1;
          else return [];
        }
        return [{ entry, score }];
      }).sort((a, b) => b.score - a.score).slice(0, 8);

      results.replaceChildren(...matches.map(({ entry }) => {
        const link = document.createElement('a');
        link.className = 'search-result';
        link.href = entry.url;
        const title = document.createElement('strong');
        title.textContent = entry.title;
        const group = document.createElement('span');
        group.className = 'search-group';
        group.textContent = entry.group;
        link.append(title, group);
        if (entry.summary) {
          const summary = document.createElement('span');
          summary.className = 'search-summary';
          summary.textContent = entry.summary;
          link.append(summary);
        }
        return link;
      }));
      status.textContent = matches.length ? '' : (dialog.dataset.empty ?? '');
    }

    async function openSearch() {
      if (!dialog || !input || !status || !url || dialog.open) return;
      dialog.showModal();
      input.focus();
      if (index) return update();
      if (fetching) return;
      status.textContent = dialog.dataset.loading ?? '';
      fetching = true;
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Search index unavailable');
        index = await response.json() as Result[];
        update();
      } catch {
        status.textContent = dialog.dataset.error ?? '';
      } finally {
        fetching = false;
      }
    }

    for (const button of buttons) button.addEventListener('click', openSearch);
    input.addEventListener('input', update);
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      results.querySelector('a')?.click();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else void openSearch();
      }
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const links = Array.from(results.querySelectorAll('a'));
      if (!links.length) return;
      const active = links.findIndex((link) => link === document.activeElement);
      const next = event.key === 'ArrowDown' ? active + 1 : active - 1;
      event.preventDefault();
      if (next < 0 || next >= links.length) input.focus();
      else links[next]?.focus();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
