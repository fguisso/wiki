---
import WikiAscii from './WikiAscii.astro';
import type { AsciiBackgroundScene } from '../lib/ascii-background';

interface Props {
  title: string;
  scene: AsciiBackgroundScene;
  description?: string | null;
}

const { title, scene, description } = Astro.props;
---

<div class="document-title-art" data-tone={scene.tone}>
  <div class="document-title-copy">
    <h1>{title}</h1>
    {description && <p class="document-lead">{description}</p>}
    <slot />
  </div>
  <div class="document-artwork" aria-hidden="true">
    <WikiAscii {scene} />
  </div>
</div>
